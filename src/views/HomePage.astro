---
import BaseLayout from '../layouts/BaseLayout.astro';
import LionIcon from '../components/LionIcon.astro';
import OpenStatus from '../components/OpenStatus.astro';
import OrnamentRule from '../components/OrnamentRule.astro';
import OrnamentCorner from '../components/OrnamentCorner.astro';
import KilimBand from '../components/KilimBand.astro';
import info from '../data/info.json';
import { t, formatNumber, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const rating = t(locale, 'hero.rating', {
  value: formatNumber(locale, info.rating.value, 1),
  count: formatNumber(locale, info.rating.count),
});
// Sections (content arrives in phases 2–3)
const sections = [
  { id: 'jelovnik', key: 'trpeza', lion: 'trpeza', dark: false },
  { id: 'podrum', key: 'podrum', lion: 'podrum', dark: true },
  { id: 'kuca', key: 'kuca', lion: 'kuca', dark: false },
  { id: 'knjiga', key: 'knjiga', lion: null, dark: false },
  { id: 'kapija', key: 'kapija', lion: 'kapija', dark: true },
] as const;
---
<BaseLayout locale={locale}>
  <section class="hero dark wood marble-veins" aria-labelledby="hero-title">
    <OrnamentCorner position="tl" />
    <OrnamentCorner position="br" />
    <span class="hero__lion" aria-hidden="true"><LionIcon variant="half" /></span>
    <div class="container hero__inner">
      <p class="label hero__kicker">{t(locale, 'brand.place')} · 1799</p>
      <h1 id="hero-title" class="hero__title">{t(locale, 'hero.title')}</h1>
      <OrnamentRule width="15rem" class="hero__rule" />
      <p class="hero__sub italic-display">{t(locale, 'hero.sub')}</p>
      <div class="hero__ctas">
        <a class="btn" href="#jelovnik">{t(locale, 'cta.seeMenu')}</a>
        <a class="btn btn--ghost" href="#kapija">{t(locale, 'cta.reserveTable')}</a>
      </div>
      <div class="hero__meta">
        <a class="hero__rating" href={info.links.googleMaps} target="_blank" rel="noopener">{rating}</a>
        <OpenStatus locale={locale} tone="dark" />
      </div>
    </div>
  </section>
  <KilimBand height={14} />

  {sections.map((s) => (
    <section id={s.id} class:list={['section', { 'dark forest marble-veins': s.dark }]} aria-labelledby={`${s.id}-title`}>
      <div class="container section-head">
        {s.lion && <span class="section-lion" aria-hidden="true"><LionIcon variant={s.lion} /></span>}
        {s.key !== 'knjiga' && <span class="label">{t(locale, `nav.${s.key}.lion`)}</span>}
        <h2 id={`${s.id}-title`}>{t(locale, `section.${s.key}`)}</h2>
        <OrnamentRule />
        <p class="wip">{t(locale, 'wip')}</p>
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: calc(100svh - var(--header-h) - var(--bottom-bar-h));
    display: grid;
    align-items: center;
    padding-block: var(--space-8);
  }
  .hero__inner { position: relative; z-index: 1; text-align: center; }
  .hero__kicker { margin-bottom: 1rem; }
  .hero__title {
    color: var(--cream);
    font-size: var(--step-5);
    font-weight: 600;
    margin-bottom: 1rem;
  }
  .hero__inner :global(.hero__rule) { margin-bottom: 1.25rem; }
  .hero__sub {
    max-width: 34rem;
    margin: 0 auto 2rem;
    font-size: var(--step-2);
    line-height: 1.3;
    color: var(--cream-dim);
  }
  .hero__ctas { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-bottom: 2rem; }
  .hero__meta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 0.75rem 1.25rem; }
  .hero__rating {
    color: var(--gold-light);
    text-decoration: none;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
  }
  .hero__rating:hover { text-decoration: underline; }
  /* The half-lion peeking from the edge */
  .hero__lion {
    position: absolute;
    left: 0;
    bottom: -4%;
    width: clamp(7rem, 22vw, 19rem);
    color: color-mix(in srgb, var(--gold) 14%, transparent);
    pointer-events: none;
  }
  @media (min-width: 48rem) { .hero__lion { color: color-mix(in srgb, var(--gold) 22%, transparent); } }
  .section-lion {
    display: block;
    width: 4.25rem;
    height: 4.25rem;
    margin: 0 auto 1rem;
    padding: 0.5rem;
    border-radius: 50%;
    color: var(--ink);
    background: color-mix(in srgb, var(--taupe) 55%, transparent);
    box-shadow: 0 0 0 1px var(--gold), 0 0 0 5px var(--bg), 0 0 0 6px color-mix(in srgb, var(--gold) 50%, transparent);
  }
  .dark .section-lion { color: var(--gold); background: var(--wood); }
  .wip { margin-top: 1.5rem; color: var(--fg-muted); font-style: italic; }
</style>
