---
import BaseLayout from '../layouts/BaseLayout.astro';
import OpenStatus from '../components/OpenStatus.astro';
import LangSwitch from '../components/LangSwitch.astro';
import LionIcon from '../components/LionIcon.astro';
import MenuFull from '../components/MenuFull.astro';
import info from '../data/info.json';
import { t, localePath, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<BaseLayout locale={locale} title={t(locale, 'meta.menuTitle')} lite onHome={false}>
  <header slot="header" class="qr-head">
    <div class="container qr-head__bar">
      <a href={localePath(locale, '/')} class="qr-head__brand" aria-label={t(locale, 'menu.backHome')}>
        <span class="qr-head__lion"><LionIcon variant="half" /></span>
        <span>{t(locale, 'brand.name')}</span>
      </a>
      <LangSwitch locale={locale} />
    </div>
    <div class="container qr-head__meta">
      <OpenStatus locale={locale} />
      <a class="qr-head__tel" href={`tel:${info.phone.intl}`}>{info.phone.display}</a>
    </div>
  </header>
  <div class="container qr-main">
    <h1 class="qr-title">{t(locale, 'nav.trpeza.label')}</h1>
    <MenuFull locale={locale} lite />
  </div>
</BaseLayout>
<style>
  .qr-head { border-bottom: 1px solid var(--line); }
  .qr-head__bar { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding-block: 0.5rem; }
  .qr-head__brand { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; line-height: 1.1; color: var(--bordeaux); text-decoration: none; min-height: 2.75rem; }
  .qr-head__lion { width: 1.6rem; height: 2.4rem; overflow: hidden; display: block; }
  .qr-head__lion :global(svg) { width: 100%; height: 100%; }
  .qr-head__meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem; padding-bottom: 0.6rem; }
  .qr-head__tel { color: var(--bordeaux); font-weight: 600; font-size: 0.9rem; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .qr-main { padding-block: 1rem 3rem; }
  .qr-title { font-size: var(--step-4); text-align: center; margin: 0.5rem 0 0; }
  .qr-main :global(.menu) { padding-inline: 0; }
  .qr-main :global(.menu--lite .menu__tools) { margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
</style>
