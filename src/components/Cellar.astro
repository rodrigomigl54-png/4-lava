---
import wines from '../data/wines.json';
import Bottle from './Bottle.astro';
import LionIcon from './LionIcon.astro';
import OrnamentRule from './OrnamentRule.astro';
import PairingWheel from './PairingWheel.astro';
import { t, pick, formatPrice, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const dev = import.meta.env.DEV;
---
<section id="podrum" class="cellar section dark forest marble-veins" aria-labelledby="podrum-title">
  <span class="cellar__lion" aria-hidden="true"><LionIcon variant="half" /></span>
  <div class="container">
    <header class="section-head">
      <span class="section-lion" aria-hidden="true"><LionIcon variant="podrum" /></span>
      <span class="label">{t(locale, 'cellar.kicker')}</span>
      <h2 id="podrum-title">{t(locale, 'cellar.title')}</h2>
      <OrnamentRule />
      <p class="cellar__intro">{t(locale, 'cellar.intro')}</p>
    </header>

    <ul class="shelf" role="list">
      {wines.wines.map((w) => (
        <li class="shelf__item" data-reveal>
          <div class="shelf__bottle"><Bottle type={w.type} label={pick(locale, w.name).split(' — ')[0].slice(0, 10)} /></div>
          <div class="shelf__tag">
            <span class="label">{t(locale, `cellar.type.${w.type}`)}</span>
            <h3>{pick(locale, w.name)}{dev && w.verify && <span class="verify-dot" title="TODO_VERIFY" />}</h3>
            {w.winery && <p class="shelf__winery">{w.winery}</p>}
            <p>{pick(locale, w.note)}</p>
            <p class="shelf__price">
              {w.priceGlass || w.priceBottle
                ? <>{w.priceGlass && <span>{t(locale, 'cellar.glass')} {formatPrice(locale, w.priceGlass)}</span>}{w.priceBottle && <span>{t(locale, 'cellar.bottle')} {formatPrice(locale, w.priceBottle)}</span>}</>
                : <span>{t(locale, 'cellar.priceSoon')}</span>}
            </p>
          </div>
        </li>
      ))}
    </ul>
    <div class="shelf__plank" aria-hidden="true"></div>

    <div class="cellar__grid">
      <article class="bermet" data-reveal>
        <h3>{t(locale, 'cellar.bermetTitle')}</h3>
        <OrnamentRule width="10rem" class="bermet__rule" />
        <p>{t(locale, 'cellar.bermetText')}</p>
      </article>
      <PairingWheel locale={locale} />
    </div>
  </div>
</section>

<style>
  .cellar { overflow: hidden; }
  .cellar__lion {
    position: absolute; right: 0; top: 10%; width: clamp(6rem, 16vw, 13rem);
    color: color-mix(in srgb, var(--gold) 12%, transparent); transform: scaleX(-1); pointer-events: none;
  }
  .cellar__intro { max-width: 36rem; margin: 1.25rem auto 0; color: var(--cream-dim); }
  .shelf {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 2.5rem 1.5rem; grid-template-columns: 1fr;
  }
  .shelf__item { display: grid; grid-template-columns: 4rem 1fr; gap: 1.25rem; align-items: end; }
  .shelf__bottle { transition: transform var(--dur-3) var(--ease-out); }
  .shelf__item:hover .shelf__bottle { transform: translateY(-6px) rotate(-2deg); }
  .shelf__tag {
    position: relative; padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent);
    background: color-mix(in srgb, var(--wood) 55%, transparent);
  }
  .shelf__tag h3 { font-size: var(--step-1); color: var(--cream); margin-bottom: 0.4rem; }
  .shelf__tag p { margin: 0 0 0.4rem; font-size: 0.95rem; color: var(--cream-dim); }
  .shelf__price { display: flex; gap: 1rem; font-size: 0.85rem !important; color: var(--gold-light) !important; letter-spacing: 0.04em; }
  .shelf__plank {
    height: 14px; margin-top: 1rem;
    background: linear-gradient(#5a3d26, #3a2618 60%, #24170f);
    border-top: 1px solid var(--gold);
    box-shadow: 0 14px 20px -10px rgb(0 0 0 / 0.7);
    display: none;
  }
  .cellar__grid { display: grid; gap: 3.5rem; margin-top: var(--space-8); align-items: center; }
  .bermet { max-width: 30rem; }
  .bermet h3 { color: var(--cream); font-size: var(--step-3); font-style: italic; font-weight: 500; }
  .bermet :global(.bermet__rule) { margin: 0 0 1rem; }
  .bermet p { color: var(--cream-dim); }
  .verify-dot { display: inline-block; width: 0.5rem; height: 0.5rem; margin-left: 0.4rem; border-radius: 50%; background: #e33; vertical-align: super; }
  @media (min-width: 48rem) {
    .shelf { grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); align-items: end; }
    .shelf__item { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .shelf__bottle { width: 5.5rem; margin-bottom: -1.2rem; position: relative; z-index: 1; }
    .shelf__tag { width: 100%; padding-top: 1.6rem; }
    .shelf__price { justify-content: center; }
    .cellar__grid { grid-template-columns: 1fr 1fr; }
  }
</style>
