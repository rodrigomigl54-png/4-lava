---
import Emblem from './Emblem.astro';
import OrnamentRule from './OrnamentRule.astro';
import { ITEMS, priceText, wineName } from '../lib/menu';
import { t, pick, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const list = ITEMS.filter((i) => i.category === 'specijaliteti' && i.featured);
const dev = import.meta.env.DEV;
---
<div class="spec">
  <header class="spec__head">
    <span class="label">{t(locale, 'spec.kicker')}</span>
    <h3>{t(locale, 'spec.title')}</h3>
  </header>
  <ul class="spec__grid" role="list">
    {list.map((i) => (
      <li class="spec-card" data-reveal data-origin={i.origin}>
        <div class="spec-card__top">
          {(i.origin === 'vienna' || i.origin === 'istanbul') && <Emblem kind={i.origin} size="2.4rem" class={`spec-card__seal spec-card__seal--${i.origin}`} />}
          <span class="spec-card__origin">{t(locale, `origin.${i.origin}`)}</span>
        </div>
        <h4 class="spec-card__name">{pick(locale, i.name)}{dev && i.verify && <span class="verify-dot" title="TODO_VERIFY" />}</h4>
        <OrnamentRule width="7rem" class="spec-card__rule" />
        <p class="spec-card__desc">{pick(locale, i.desc)}</p>
        <div class="spec-card__foot">
          {i.price != null && <span class="spec-card__price">{priceText(locale, i)}</span>}
          {i.pairing && <span class="chip-pair"><svg viewBox="0 0 16 24" aria-hidden="true"><path d="M3 1h10c0 6-1 10-5 10S3 7 3 1Zm5 10v10M4 23h8" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>{t(locale, 'spec.pairing')} {wineName(locale, i.pairing)}</span>}
        </div>
      </li>
    ))}
  </ul>
</div>
<style>
  .spec__head { text-align: center; margin-bottom: var(--space-6); }
  .spec__head .label { display: block; margin-bottom: 0.4rem; }
  .spec__head h3 { font-size: var(--step-3); }
  .spec__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .spec-card {
    position: relative; display: flex; flex-direction: column; padding: 1.75rem 1.5rem 1.4rem;
    background: color-mix(in srgb, var(--cream) 55%, white); border: 1px solid var(--line);
    box-shadow: inset 0 0 0 5px color-mix(in srgb, var(--cream) 55%, white), inset 0 0 0 6px color-mix(in srgb, var(--gold) 35%, transparent);
    transition: transform var(--dur-3) var(--ease-out), box-shadow var(--dur-3) var(--ease-out);
  }
  .spec-card:hover { transform: translateY(-4px); box-shadow: inset 0 0 0 5px color-mix(in srgb, var(--cream) 55%, white), inset 0 0 0 6px var(--gold), var(--shadow-soft); }
  .spec-card__top { display: flex; align-items: center; gap: 0.6rem; min-height: 2.4rem; margin-bottom: 0.6rem; }
  .spec-card :global(.spec-card__seal--vienna) { color: var(--gold-ink); }
  .spec-card :global(.spec-card__seal--istanbul) { color: var(--istanbul); }
  .spec-card__origin { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--label); }
  .spec-card__name { font-size: var(--step-2); margin: 0; }
  .spec-card :global(.spec-card__rule) { margin: 0.7rem 0 0.8rem; }
  .spec-card__desc { color: var(--fg-muted); font-size: 0.95rem; flex: 1; }
  .spec-card__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem; margin-top: 0.5rem; }
  .spec-card__price { font-family: var(--font-display); font-size: var(--step-2); font-weight: 600; color: var(--bordeaux); }
  .chip-pair { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.25rem 0.7rem; border-radius: 999px; font-size: 0.8rem; background: color-mix(in srgb, var(--bordeaux) 8%, transparent); color: var(--bordeaux); border: 1px solid color-mix(in srgb, var(--bordeaux) 25%, transparent); }
  .chip-pair svg { width: 0.6rem; height: 0.9rem; }
  .verify-dot { display: inline-block; width: 0.5rem; height: 0.5rem; margin-left: 0.4rem; border-radius: 50%; background: #e33; vertical-align: super; }
</style>
