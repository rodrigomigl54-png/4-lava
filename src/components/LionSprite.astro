---
// The traced stencil lion (from public/brand/logo-lion.jpg via potrace),
// emitted ONCE per page as an SVG <symbol>; every lion on the page <use>s it.
import inner from '../assets/lion-inner.svg.txt?raw';
---
<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute;overflow:hidden">
  <symbol id="lion" viewBox="0 0 1296 1296" fill="currentColor"><Fragment set:html={inner} /></symbol>
</svg>
