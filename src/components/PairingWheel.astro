---
import { ITEMS, DRINKS, PAIRING_REASONS } from '../lib/menu';
import { t, pick, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;

const R = 150, C = 160;
const pt = (deg: number, r: number) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [C + r * Math.cos(a), C + r * Math.sin(a)];
};
const FILLS = {
  wine: ['#5E1A1F', '#2F3B2C', '#7A3A12', '#3b0f19', '#1F5C5C'],
  rakija: ['#8a5a1c', '#5a3a14', '#a8742a', '#3e2610', '#6b4a1e'],
};
const wheels = (['wine', 'rakija'] as const).map((kind) => {
  const drinks = DRINKS.filter((d) => d.kind === kind);
  const seg = 360 / drinks.length;
  return {
    kind,
    drinks: drinks.map((d, i) => {
      const a0 = i * seg - seg / 2, a1 = a0 + seg;
      const [x0, y0] = pt(a0, R), [x1, y1] = pt(a1, R);
      const [name, sub] = pick(locale, d.name).split(' — ');
      return { id: d.id, name, sub, angle: i * seg, why: pick(locale, PAIRING_REASONS[d.id]), fill: FILLS[kind][i % 5],
        path: `M${C} ${C}L${x0} ${y0}A${R} ${R} 0 0 1 ${x1} ${y1}Z` };
    }),
  };
});
const dishes = ITEMS.filter((i) => i.category !== 'pica' && (i.pairing || i.pairingRakija))
  .map((i) => ({ name: pick(locale, i.name), wine: i.pairing ?? '', rakija: i.pairingRakija ?? '' }));
const data = Object.fromEntries(wheels.map((w) => [w.kind, w.drinks.map(({ id, angle, name, why }) => ({ id, angle, name, why }))]));
---
<div class="wheel" data-wheel data-drinks={JSON.stringify(data)} data-result-tpl={t(locale, 'pairing.result')}>
  <h3 class="wheel__title">{t(locale, 'pairing.title')}</h3>
  <div class="wheel__mode" role="group" aria-label={t(locale, 'pairing.mode')}>
    <button type="button" data-wheel-mode="wine" aria-pressed="true">🍷 {t(locale, 'pairing.wine')}</button>
    <button type="button" data-wheel-mode="rakija" aria-pressed="false">🥃 {t(locale, 'pairing.rakija')}</button>
  </div>
  <div class="field wheel__field">
    <label for="wheel-dish">{t(locale, 'pairing.choose')}</label>
    <select id="wheel-dish" class="input" data-wheel-select>
      <option value="">{t(locale, 'pairing.pick')}</option>
      {dishes.map((d) => <option value="" data-wine={d.wine} data-rakija={d.rakija} hidden={!d.wine}>{d.name}</option>)}
    </select>
  </div>
  <div class="wheel__stage">
    <svg class="wheel__pointer" viewBox="0 0 30 34" aria-hidden="true"><path d="M15 34 2 6a14 14 0 1 1 26 0Z" fill="#B08D57" /><circle cx="15" cy="12" r="5" fill="#2A1E17" /></svg>
    {wheels.map((w) => (
      <svg class="wheel__disc" viewBox="0 0 320 320" aria-hidden="true" data-wheel-disc={w.kind} hidden={w.kind !== 'wine'}>
        <circle cx={C} cy={C} r={R + 8} fill="#2A1E17" stroke="#B08D57" stroke-width="1.5" />
        {w.drinks.map((s) => (
          <g>
            <path d={s.path} fill={s.fill} stroke="#B08D57" stroke-width="1" />
            <text transform={`rotate(${s.angle} ${C} ${C})`} x={C} y={C - R + 32} text-anchor="middle" font-family="Cormorant Garamond, serif" font-weight="600" font-size="15" fill="#F3EBDD">{s.name}</text>
          </g>
        ))}
        {Array.from({ length: 36 }, (_, i) => { const [x0, y0] = pt(i * 10, R + 2); const [x1, y1] = pt(i * 10, R + (i % 3 ? 6 : 8)); return <line x1={x0} y1={y0} x2={x1} y2={y1} stroke="#B08D57" stroke-width="1" />; })}
        <circle cx={C} cy={C} r="38" fill="#2A1E17" stroke="#B08D57" stroke-width="1.5" />
        <circle cx={C} cy={C} r="31" fill="none" stroke="#B08D57" stroke-width=".6" />
        <g transform={`translate(${C - 26} ${C - 30})`} style="color:#B08D57"><use href="#lion" width="60" height="60" /></g>
      </svg>
    ))}
  </div>
  <p class="wheel__result" aria-live="polite" data-wheel-result>{t(locale, 'pairing.hint')}</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-wheel]').forEach((w) => {
    type D = { id: string; angle: number; name: string; why: string };
    const data = JSON.parse(w.dataset.drinks || '{}') as Record<string, D[]>;
    const sel = w.querySelector<HTMLSelectElement>('[data-wheel-select]')!;
    const out = w.querySelector<HTMLElement>('[data-wheel-result]')!;
    const hint = out.textContent || '';
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let mode: 'wine' | 'rakija' = 'wine';
    const rot: Record<string, number> = { wine: 0, rakija: 0 };
    const disc = () => w.querySelector<SVGElement>(`[data-wheel-disc="${mode}"]`)!;

    w.querySelectorAll<HTMLButtonElement>('[data-wheel-mode]').forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.wheelMode as 'wine' | 'rakija';
      w.querySelectorAll('[data-wheel-mode]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      w.querySelectorAll<SVGElement>('[data-wheel-disc]').forEach((d) => (d.hidden = d.dataset.wheelDisc !== mode));
      [...sel.options].forEach((o, i) => { if (i) o.hidden = !o.dataset[mode]; });
      sel.selectedIndex = 0;
      out.textContent = hint;
    }));

    sel.addEventListener('change', () => {
      const id = sel.selectedOptions[0]?.dataset[mode];
      const d = data[mode].find((x) => x.id === id);
      if (!d) return;
      const cur = ((rot[mode] % 360) + 360) % 360;
      rot[mode] += 360 + (((-d.angle - cur) % 360) + 360) % 360;
      disc().style.transform = `rotate(${rot[mode]}deg)`;
      out.innerHTML = '';
      const strong = document.createElement('strong');
      strong.textContent = (w.dataset.resultTpl || '{drink}').replace('{drink}', d.name);
      const span = document.createElement('span');
      span.textContent = d.why;
      setTimeout(() => out.append(strong, document.createElement('br'), span), reduce ? 0 : 1300);
    });
  });
</script>

<style>
  .wheel { display: grid; gap: 1.1rem; justify-items: center; text-align: center; }
  .wheel__title { color: var(--cream); margin: 0; }
  .wheel__mode { display: inline-flex; gap: 0.3rem; padding: 0.25rem; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent); background: rgb(0 0 0 / 0.2); }
  .wheel__mode button { min-height: 2.6rem; padding: 0.25rem 1.1rem; border: 0; border-radius: 999px; background: transparent; color: var(--cream); cursor: pointer; font-weight: 600; }
  .wheel__mode button[aria-pressed='true'] { background: var(--gold); color: var(--wood); }
  .wheel__field { width: min(100%, 22rem); text-align: left; }
  .wheel__stage { position: relative; width: min(100%, 20rem); aspect-ratio: 1; }
  .wheel__pointer { position: absolute; z-index: 1; top: -0.6rem; left: 50%; width: 1.8rem; transform: translateX(-50%); filter: drop-shadow(0 3px 3px rgb(0 0 0 / 0.5)); }
  .wheel__disc { position: absolute; inset: 0; width: 100%; height: 100%; transition: transform 1.6s cubic-bezier(0.17, 0.84, 0.32, 1); filter: drop-shadow(0 14px 22px rgb(0 0 0 / 0.5)); }
  .wheel__disc[hidden] { display: none; }
  .wheel__result { min-height: 3.5em; max-width: 26rem; margin: 0; color: var(--cream-dim); }
  .wheel__result :global(strong) { font-family: var(--font-display); font-size: var(--step-1); color: var(--gold-light); }
</style>
