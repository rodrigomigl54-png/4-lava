---
/** Thin gold baroque rule with a central flourish. Draws itself when `data-draw` is in view. */
interface Props { class?: string; width?: string }
const { class: cls = '', width = '18rem' } = Astro.props;
---
<svg class:list={['orn-rule', cls]} viewBox="0 0 320 24" style={`width:${width}`} aria-hidden="true" focusable="false" data-draw>
  <g fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round">
    <path pathLength="1" d="M4 12 H118" />
    <path pathLength="1" d="M316 12 H202" />
    <path pathLength="1" d="M118 12 C130 12 134 3 145 4 C153 5 155 12 150 15 C146 18 140 14 143 10" />
    <path pathLength="1" d="M202 12 C190 12 186 3 175 4 C167 5 165 12 170 15 C174 18 180 14 177 10" />
    <path pathLength="1" d="M160 3 L167 12 L160 21 L153 12 Z" />
    <path pathLength="1" d="M150 15 C154 20 166 20 170 15" />
  </g>
  <circle cx="160" cy="12" r="1.6" fill="currentColor" />
  <circle cx="4" cy="12" r="1.3" fill="currentColor" />
  <circle cx="316" cy="12" r="1.3" fill="currentColor" />
</svg>
<style>
  .orn-rule { display: block; height: auto; margin-inline: auto; color: var(--gold); overflow: visible; }
</style>
