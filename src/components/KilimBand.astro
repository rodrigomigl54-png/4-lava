---
/**
 * Narrow repeating band inspired by Vojvodina kilims / Srem cross-stitch:
 * stepped diamonds with "hooks" and small crosses. Used ONLY as a divider/border.
 */
interface Props { class?: string; height?: number; tone?: 'light' | 'dark' }
const { class: cls = '', height = 18, tone = 'light' } = Astro.props;
const id = `kilim-${Math.random().toString(36).slice(2, 8)}`;
const a = tone === 'dark' ? '#B08D57' : '#8E2A2A';
const b = tone === 'dark' ? '#8E2A2A' : '#B08D57';
---
<svg class:list={['kilim', cls]} height={height} width="100%" aria-hidden="true" focusable="false" preserveAspectRatio="none">
  <defs>
    <pattern id={id} width="36" height="18" patternUnits="userSpaceOnUse">
      <!-- stepped diamond -->
      <path d="M18 1h2v2h2v2h2v2h2v4h-2v2h-2v2h-2v2h-2v-2h-2v-2h-2v-2h-2V7h2V5h2V3h2z" fill={a} />
      <path d="M18 6h2v2h2v2h-2v2h-2v-2h-2V8h2z" fill={b} />
      <!-- hooks between diamonds -->
      <path d="M2 8h4v2H4v2H2zM34 8h-4v2h2v2h2z" fill={b} />
      <path d="M0 0h36v1H0zM0 17h36v1H0z" fill={b} opacity=".75" />
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`} />
</svg>
<style>
  .kilim { display: block; width: 100%; }
</style>
