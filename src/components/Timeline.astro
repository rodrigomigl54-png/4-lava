---
import timeline from '../data/timeline.json';
import { t, pick, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const events = timeline.events.filter((e) => !e.hidden);
---
<div class="tl" data-timeline>
  <h3 class="tl__title">{t(locale, 'timeline.title')}</h3>
  <div class="tl__track">
    <ol class="tl__list" role="list">
      {events.map((e, i) => (
        <li class="tl__item" data-tl-item style={`--i:${i}`}>
          <span class="tl__dot" aria-hidden="true"></span>
          <p class="tl__year">{typeof e.year === 'string' ? e.year : pick(locale, e.year as { sr: string; en: string })}</p>
          <h4 class="tl__name">{pick(locale, e.title)}</h4>
          <p class="tl__text">{pick(locale, e.text)}</p>
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
  .tl { margin-top: var(--space-8); }
  .tl__title { text-align: center; margin-bottom: var(--space-6); }
  .tl__track { --progress: 1; position: relative; }
  .tl__list { list-style: none; margin: 0; padding: 0 0 0 2.6rem; display: grid; gap: 2.25rem; position: relative; }
  /* gold line that draws itself (progress set by GSAP ScrollTrigger) */
  .tl__list::before {
    content: ''; position: absolute; left: 0.55rem; top: 0.6rem; bottom: 0.6rem; width: 1.5px;
    background: linear-gradient(var(--gold), var(--gold)) no-repeat;
    background-size: 100% calc(var(--progress) * 100%);
  }
  .tl__item { position: relative; }
  .tl__dot {
    position: absolute; left: -2.6rem; top: 0.55rem; width: 1.2rem; height: 1.2rem;
    border-radius: 50%; background: var(--bg); border: 1.5px solid var(--gold);
    box-shadow: inset 0 0 0 3px var(--bg), inset 0 0 0 10px var(--marble-red);
  }
  .tl__year { font-family: var(--font-display); font-size: var(--step-3); font-weight: 600; color: var(--gold-ink); line-height: 1; margin: 0 0 0.35rem; }
  .tl__name { font-size: var(--step-1); margin-bottom: 0.3rem; }
  .tl__text { margin: 0; color: var(--fg-muted); font-size: 0.95rem; }
  @media (min-width: 64rem) {
    .tl__list { padding: 0; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); grid-auto-flow: column; gap: 1.5rem; }
    .tl__list::before {
      left: 0.6rem; right: 0; top: 0.6rem; bottom: auto; width: auto; height: 1.5px;
      background-size: calc(var(--progress) * 100%) 100%;
    }
    .tl__dot { position: relative; left: 0; top: 0; display: block; margin-bottom: 1.2rem; }
  }
</style>
