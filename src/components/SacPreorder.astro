---
import info from '../data/info.json';
import SendButtons from './SendButtons.astro';
import { ITEMS, priceText } from '../lib/menu';
import { asset } from '../lib/base';
import { t, pick, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const dishes = ITEMS.filter((i) => i.preorder);
const weekdays = ['7', '1', '2', '3', '4', '5', '6'].map((d) => t(locale, `days.${d}`));
const cfg = {
  template: t(locale, 'sac.msg'),
  phone: { intl: info.phone.intl, whatsapp: info.phone.whatsapp },
  weekdays, lang: locale,
  words: { one: t(locale, 'word.person1'), few: t(locale, 'word.person2'), many: t(locale, 'word.person5') },
  s: { required: t(locale, 'form.err.required'), date: t(locale, 'form.err.date'), check: t(locale, 'form.err.check'), ok: t(locale, 'form.ok'), viberCopied: t(locale, 'form.viberCopied') },
};
const id = 'sac';
---
<div class="sac dark wood marble-veins" id="sac">
  <div class="sac__grid">
    <div class="sac__art" aria-hidden="true">
      <div class="sac-fire" data-sac-fire>
        <canvas class="sac-fire__layer" data-fire-back></canvas>
        <img class="sac-fire__img" src={asset('/img/sac.webp')} alt="" width="779" height="536" loading="lazy" decoding="async" data-sac-img />
        <div class="sac-fire__heat" data-sac-heat style={`--sac-mask:url(${asset('/img/sac.webp')});-webkit-mask-image:url(${asset('/img/sac.webp')})`}></div>
        <canvas class="sac-fire__layer sac-fire__layer--front" data-fire-front></canvas>
      </div>
    </div>
    <div>
      <h3 class="sac__title">{t(locale, 'sac.title')}</h3>
      <p class="sac__lead italic-display">{t(locale, 'sac.lead')}</p>
      <p class="sac__lead2">{t(locale, 'sac.lead2')}</p>
      <ul class="sac__list" role="list">
        {dishes.map((d) => <li><span>{pick(locale, d.name)}</span><span>{priceText(locale, d)}</span></li>)}
      </ul>
    </div>
  </div>

  <form class="form sac__form" data-msg-form data-cfg={JSON.stringify(cfg)} novalidate>
    <h4 class="sac__form-title">{t(locale, 'sac.form')}</h4>
    <div class="form__row form__row--2">
      <div class="field">
        <label for={`${id}-dish`}>{t(locale, 'sac.dish')}</label>
        <select class="input" id={`${id}-dish`} name="dish" required data-sac-dish aria-describedby={`${id}-dish-err`}>
          <option value="">—</option>
          {dishes.map((d) => <option value={d.id} data-hours={d.preorderHours ?? 0} data-text={pick(locale, d.name)}>{pick(locale, d.name)}</option>)}
        </select>
        <p class="field__err" id={`${id}-dish-err`} data-err-for="dish"></p>
        <p class="sac__hours" data-sac-hours data-tpl={t(locale, 'sac.hoursAhead')}></p>
      </div>
      <div class="field">
        <span class="field__label" id={`${id}-people-l`}>{t(locale, 'form.people')}</span>
        <div class="stepper" data-stepper role="group" aria-labelledby={`${id}-people-l`}>
          <button type="button" data-step="-1" aria-label={t(locale, 'form.minus')}>−</button>
          <input class="input" name="people" type="number" min="1" max="40" value="4" inputmode="numeric" aria-labelledby={`${id}-people-l`} />
          <button type="button" data-step="1" aria-label={t(locale, 'form.plus')}>+</button>
        </div>
      </div>
    </div>
    <div class="form__row form__row--2">
      <div class="field">
        <label for={`${id}-date`}>{t(locale, 'form.date')}</label>
        <input class="input" id={`${id}-date`} name="date" type="date" required data-min-today aria-describedby={`${id}-date-err`} />
        <p class="field__err" id={`${id}-date-err`} data-err-for="date"></p>
      </div>
      <div class="field">
        <label for={`${id}-time`}>{t(locale, 'form.time')}</label>
        <input class="input" id={`${id}-time`} name="time" type="time" value="14:00" min="08:00" max="22:00" step="900" required />
      </div>
    </div>
    <div class="form__row form__row--2">
      <div class="field">
        <label for={`${id}-name`}>{t(locale, 'form.name')}</label>
        <input class="input" id={`${id}-name`} name="name" autocomplete="name" required aria-describedby={`${id}-name-err`} />
        <p class="field__err" id={`${id}-name-err`} data-err-for="name"></p>
      </div>
      <div class="field">
        <label for={`${id}-note`}>{t(locale, 'form.note')} <small>({t(locale, 'form.optional')})</small></label>
        <input class="input" id={`${id}-note`} name="note" />
      </div>
    </div>
    <details class="preview-wrap"><summary>{t(locale, 'form.preview')}</summary><pre class="preview" data-preview></pre></details>
    <SendButtons locale={locale} />
  </form>
</div>

<script>
  import { initSacFire } from '../scripts/sac-fire';
  document.querySelectorAll<HTMLElement>('[data-sac-fire]').forEach(initSacFire);
  import { initMessageForms } from '../scripts/message-forms';
  import { belgradeISODate } from '../lib/message';
  const sel = document.querySelector<HTMLSelectElement>('[data-sac-dish]');
  const date = document.querySelector<HTMLInputElement>('#sac-date');
  const hintEl = document.querySelector<HTMLElement>('[data-sac-hours]');
  const sync = () => {
    const h = Number(sel?.selectedOptions[0]?.dataset.hours || 0);
    if (date) { date.min = belgradeISODate(h); if (!date.value || date.value < date.min) date.value = date.min; }
    if (hintEl) hintEl.textContent = h ? (hintEl.dataset.tpl || '').replace('{h}', String(h)) : '';
  };
  sel?.addEventListener('change', sync);
  // a dish link elsewhere on the page can preselect: <a href="#sac" data-preorder="id">
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLElement>('[data-preorder]');
    if (a && sel) { sel.value = a.dataset.preorder || ''; sync(); sel.dispatchEvent(new Event('change', { bubbles: true })); }
  });
  sync();
  initMessageForms();
</script>

<style>
  .sac { padding: clamp(1.5rem, 5vw, 3.5rem); margin-block: var(--space-8); border: 1px solid color-mix(in srgb, var(--gold) 45%, transparent); }
  .sac__grid { display: grid; gap: 2rem; align-items: center; margin-bottom: 2.5rem; }
  /* photographed sač + canvas fire (behind and in front) + steam */
  .sac-fire { position: relative; width: min(100%, 26rem); margin: 0 auto; aspect-ratio: 779 / 960; }
  .sac-fire__img { position: absolute; left: 6%; right: 6%; bottom: 14%; width: 88%; height: auto; z-index: 1;
    filter: drop-shadow(0 18px 16px rgb(0 0 0 / 0.6)) contrast(1.05); }
  .sac-fire__heat { position: absolute; left: 6%; right: 6%; bottom: 14%; aspect-ratio: 779 / 536; z-index: 2; pointer-events: none;
    background: linear-gradient(0deg, rgb(255 120 40 / 0.4), rgb(255 120 40 / 0.06) 28%, transparent 45%);
    mix-blend-mode: color-dodge; opacity: 0.85;
    -webkit-mask-size: 100% 100%; mask-image: var(--sac-mask); mask-size: 100% 100%; mask-repeat: no-repeat; }
  .sac-fire__layer { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; }
  .sac-fire__layer--front { z-index: 3; }
  .sac__title { color: var(--cream); font-size: var(--step-3); }
  .sac__lead { font-size: var(--step-2); color: var(--gold-light); line-height: 1.3; }
  .sac__lead2 { color: var(--cream-dim); }
  .sac__list { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: 0.3rem; }
  .sac__list li { display: flex; justify-content: space-between; gap: 1rem; padding-bottom: 0.3rem; border-bottom: 1px dotted color-mix(in srgb, var(--gold) 40%, transparent); font-size: 0.95rem; }
  .sac__list li span:last-child { color: var(--gold-light); white-space: nowrap; }
  .sac__form { max-width: 48rem; margin: 0 auto; padding-top: 2rem; border-top: 1px solid color-mix(in srgb, var(--gold) 35%, transparent); }
  .sac__form-title { color: var(--cream); font-size: var(--step-2); margin: 0; }
  .sac__hours { margin: 0; font-size: 0.82rem; color: var(--gold-light); min-height: 1em; }
  @media (min-width: 52rem) { .sac__grid { grid-template-columns: 0.9fr 1.1fr; } }
</style>
