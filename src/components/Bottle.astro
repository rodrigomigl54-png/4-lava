---
/** Stylised SVG bottle — silhouette and glass depend on the drink type. */
interface Props { type: string; label: string; class?: string }
const { type, label, class: cls = '' } = Astro.props;
const isRakija = type === 'rakija' || type === 'rakija-aged';
const glass = { white: '#6f7a3c', rose: '#c98a7a', red: '#2b1012', bermet: '#7a3a12', rakija: '#cfd9d2', 'rakija-aged': '#d8c9a4' }[type] ?? '#3a2a1a';
const shine = { white: '#c9c98a', rose: '#f1cfc4', red: '#7a3a3a', bermet: '#d08a4a', rakija: '#ffffff', 'rakija-aged': '#fff4d8' }[type] ?? '#888';
const liquid = { rakija: '#efe2b4', 'rakija-aged': '#c2782c' }[type];
// paths: x 0–60, y 0–220
const shapes: Record<string, string> = {
  white: 'M25 0h10v6l1 40c0 18 16 30 16 52v114a8 8 0 0 1-8 8H16a8 8 0 0 1-8-8V98c0-22 16-34 16-52l1-40Z',
  red: 'M24 0h12v8l1 52c0 8 14 10 14 24v128a8 8 0 0 1-8 8H17a8 8 0 0 1-8-8V84c0-14 14-16 14-24l1-52Z',
  bermet: 'M24 40h12v6l1 30c0 6 17 10 17 28v108a8 8 0 0 1-8 8H14a8 8 0 0 1-8-8V104c0-18 17-22 17-28l1-30Z',
  // rakija: tall, slim, long neck, round shoulders
  rakija: 'M26 0h8v6l1 58c0 10 13 14 13 30v118a8 8 0 0 1-8 8H20a8 8 0 0 1-8-8V94c0-16 13-20 13-30l1-58Z',
};
const d = isRakija ? shapes.rakija : shapes[type] ?? (type === 'rose' ? shapes.white : shapes.red);
const top = type === 'bermet' ? 40 : 0;
const labelY = type === 'bermet' ? 132 : isRakija ? 136 : 128;
const narrow = type === 'white' || type === 'rose';
const lx = isRakija ? 14 : narrow ? 11 : 12, lw = isRakija ? 32 : narrow ? 38 : 36;
const uid = Math.random().toString(36).slice(2, 7);
---
<svg class:list={['bottle', cls]} viewBox="-4 -6 68 232" aria-hidden="true" focusable="false">
  {isRakija ? (
    <>
      <clipPath id={`b-${uid}`}><path d={d} /></clipPath>
      <path d={d} fill={glass} opacity=".55" />
      <rect x="0" y="92" width="60" height="140" fill={liquid} opacity={type === 'rakija' ? 0.55 : 0.9} clip-path={`url(#b-${uid})`} />
      <path d="M12 92h36" stroke="#fff" stroke-width=".8" opacity=".7" clip-path={`url(#b-${uid})`} />
      <path d={d} fill="none" stroke="#fff" stroke-width="1.2" opacity=".55" />
    </>
  ) : (
    <path d={d} fill={glass} />
  )}
  <rect x={isRakija ? 25 : 23} y={top - 4} width={isRakija ? 10 : 14} height="16" rx="2" fill={isRakija ? '#8E2A2A' : '#B08D57'} />
  <path d={`M${isRakija ? 19 : 17} ${type === 'bermet' ? 112 : 104}c0-6 2-10 4-12`} stroke={shine} stroke-width="2.5" stroke-linecap="round" fill="none" opacity=".7" />
  <path d={`M${isRakija ? 19 : 17} ${type === 'bermet' ? 122 : 116}v80`} stroke={shine} stroke-width="2.5" stroke-linecap="round" opacity=".45" />
  <g transform={`translate(0 ${labelY})`}>
    <rect x={lx} y="0" width={lw} height="48" fill="#F3EBDD" />
    <rect x={lx + 2} y="2" width={lw - 4} height="44" fill="none" stroke="#B08D57" stroke-width=".8" />
    <path d="M23 12h14M25 36h10" stroke="#8E2A2A" stroke-width="1.2" />
    <text x="30" y="27" text-anchor="middle" font-family="Cormorant Garamond, serif" font-size="8.5" font-weight="600" fill="#5E1A1F">{label}</text>
  </g>
</svg>
<style>
  .bottle { width: 100%; height: auto; overflow: visible; filter: drop-shadow(0 10px 8px rgb(0 0 0 / 0.45)); }
</style>
