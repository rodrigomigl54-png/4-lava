---
/**
 * Illustrated Four Lions Fountain — red marble + gold line art.
 * Stylised (not a technical drawing). Water lines animate unless reduced motion.
 */
interface Props { class?: string; title?: string }
const { class: cls = '', title } = Astro.props;
const lionMask = (x: number, y: number) => `
  <g transform="translate(${x} ${y})">
    <circle r="15" fill="#5E1A1F" stroke="#B08D57" stroke-width="1.2"/>
    <path d="M-15 0c-4-6 0-14 5-16M15 0c4-6 0-14-5-16M-12 9c-5 2-6 8-3 11M12 9c5 2 6 8 3 11M-6-13c2-4 10-4 12 0" fill="none" stroke="#B08D57" stroke-width="1.2" stroke-linecap="round"/>
    <circle cx="-5" cy="-3" r="1.6" fill="#B08D57"/><circle cx="5" cy="-3" r="1.6" fill="#B08D57"/>
    <path d="M-4 5q4 3 8 0M0 1v4" fill="none" stroke="#B08D57" stroke-width="1.2" stroke-linecap="round"/>
    <circle cy="9" r="2.4" fill="#2A1E17" stroke="#B08D57" stroke-width=".8"/>
  </g>`;
---
<svg class:list={['fountain', cls]} viewBox="0 0 400 460" role={title ? 'img' : undefined} aria-label={title} aria-hidden={title ? undefined : 'true'}>
  <defs>
    <pattern id="f-marble" width="80" height="80" patternUnits="userSpaceOnUse">
      <rect width="80" height="80" fill="#8E2A2A" />
      <path d="M0 20c20 6 30-10 50 2s24 10 30 4M0 60c14-8 30 6 46-4s20-6 34 0M20 0c4 16-8 30 2 48" fill="none" stroke="#b5544a" stroke-width="1" opacity=".55" />
      <path d="M60 0c-6 20 10 26 4 46s-14 22-10 34" fill="none" stroke="#5E1A1F" stroke-width="1.2" opacity=".6" />
    </pattern>
  </defs>
  <g stroke="#B08D57" stroke-width="1.4" stroke-linejoin="round">
    <!-- crown: ball + obelisk + capital -->
    <circle cx="200" cy="30" r="11" fill="url(#f-marble)" />
    <path d="M192 42h16l10 80h-36Z" fill="url(#f-marble)" />
    <path d="M170 122h60v10h-60Z M162 132h76v12h-76Z" fill="#5E1A1F" />
    <!-- pedestal with lion masks -->
    <path d="M150 144h100v120h-100Z" fill="url(#f-marble)" />
    <path d="M158 152h84v104h-84Z" fill="none" />
    <path d="M140 264h120v14h-120Z" fill="#5E1A1F" />
    <!-- basin -->
    <path d="M60 300c0-14 280-14 280 0v70c0 22-280 22-280 0Z" fill="url(#f-marble)" />
    <ellipse cx="200" cy="300" rx="140" ry="16" fill="#5E1A1F" />
    <ellipse cx="200" cy="300" rx="128" ry="11" fill="#1f3a3c" stroke-width=".8" />
    <path d="M60 370c0 22 280 22 280 0" fill="none" />
    <path d="M70 330c40 10 220 10 260 0" fill="none" stroke-width=".8" opacity=".7" />
    <!-- steps -->
    <path d="M40 392h320l12 20H28Z M20 412h360v14H20Z" fill="#5E1A1F" />
  </g>
  <g set:html={lionMask(200, 198)} />
  <g set:html={lionMask(166, 198).replace('translate(166 198)', 'translate(166 198) scale(.62)')} opacity=".85" />
  <g set:html={lionMask(234, 198).replace('translate(234 198)', 'translate(234 198) scale(.62)')} opacity=".85" />
  <!-- water from the lions' mouths -->
  <g class="fountain__water" fill="none" stroke="#c9e2e0" stroke-width="2" stroke-linecap="round">
    <path d="M200 209c0 30 4 60 6 88" />
    <path d="M200 209c-6 30-14 60-22 88" />
    <path d="M166 204c-10 26-30 60-44 92" />
    <path d="M234 204c10 26 30 60 44 92" />
  </g>
  <g class="fountain__ripples" fill="none" stroke="#c9e2e0" stroke-width="1" opacity=".7">
    <ellipse cx="192" cy="300" rx="16" ry="3" />
    <ellipse cx="124" cy="299" rx="12" ry="2.5" />
    <ellipse cx="276" cy="299" rx="12" ry="2.5" />
  </g>
</svg>
<style>
  .fountain { width: 100%; height: auto; overflow: visible; }
  .fountain__water path { stroke-dasharray: 6 10; animation: water-flow 1.1s linear infinite; }
  .fountain__ripples ellipse { transform-box: fill-box; transform-origin: center; animation: ripple 2.4s var(--ease) infinite; }
  .fountain__ripples ellipse:nth-child(2) { animation-delay: 0.6s; }
  .fountain__ripples ellipse:nth-child(3) { animation-delay: 1.2s; }
  @keyframes water-flow { to { stroke-dashoffset: -32; } }
  @keyframes ripple { 0% { transform: scale(0.4); opacity: 0.9; } 100% { transform: scale(1.6); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .fountain__water path { stroke-dasharray: none; animation: none; }
    .fountain__ripples ellipse { animation: none; }
  }
</style>
