---
import fs from 'node:fs';
import path from 'node:path';
import info from '../data/info.json';
import OrnamentCorner from './OrnamentCorner.astro';
import { t, type Locale } from '../lib/i18n';
import { asset } from '../lib/base';
interface Props { locale: Locale }
const { locale } = Astro.props;
const hasPhoto = fs.existsSync(path.join(process.cwd(), 'public/img/vrata.jpg'));
// Keyless Google Maps embed, pinned on the restaurant (name + exact coordinates)
const q = encodeURIComponent(locale === 'en' ? 'Gostiona Kod 4 Lava, Trg Branka Radičevića 3, Sremski Karlovci' : info.links.mapEmbedQuery);
const embed = `https://maps.google.com/maps?q=${q}&ll=${info.geo.lat},${info.geo.lng}&z=18&hl=${locale === 'en' ? 'en' : 'sr'}&output=embed`;
---
<div class="findus">
  <h3 class="findus__title">{t(locale, 'map.title')}</h3>
  <div class="findus__grid">
    <figure class="findus__map">
      <OrnamentCorner position="tl" size="2.2rem" />
      <OrnamentCorner position="br" size="2.2rem" />
      <div class="findus__frame">
        <iframe
          src={embed}
          title={t(locale, 'map.embedTitle')}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <noscript><a href={info.links.googleMaps}>{t(locale, 'map.view')}</a></noscript>
      </div>
      <figcaption class="findus__caption">
        <span class="findus__pin" aria-hidden="true"></span>
        {t(locale, 'map.callout')} · {locale === 'en' ? info.address.en.street : t(locale, 'map.square')} 3
      </figcaption>
    </figure>

    <div class="findus__side">
      <ol class="findus__steps">
        <li>{t(locale, 'map.step1')}</li>
        <li>{t(locale, 'map.step2')}</li>
        <li>{t(locale, 'map.step3')}</li>
      </ol>
      <figure class="findus__photo">
        <OrnamentCorner position="tl" size="2rem" />
        <OrnamentCorner position="br" size="2rem" />
        {hasPhoto
          ? <img src={asset('/img/vrata.jpg')} alt={t(locale, 'map.photoAlt')} loading="lazy" decoding="async" width="800" height="1000" />
          : <div class="findus__placeholder"><svg viewBox="0 0 60 80" aria-hidden="true"><path d="M8 78V30a22 22 0 0 1 44 0v48M8 78h44M22 50h2" fill="none" stroke="currentColor" stroke-width="1.5" /></svg><span>{t(locale, 'map.photoSoon')}</span></div>}
      </figure>
      <div class="findus__btns">
        <a class="btn" href={info.links.googleDirections} target="_blank" rel="noopener">{t(locale, 'map.open')} <span aria-hidden="true">↗</span></a>
        <a class="btn btn--ghost" href={info.links.googleMaps} target="_blank" rel="noopener">{t(locale, 'map.view')} <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</div>

<style>
  .findus__title { text-align: center; margin-bottom: var(--space-6); }
  .findus__grid { display: grid; gap: 2rem; align-items: start; }
  .findus__map { position: relative; margin: 0; padding: 0.7rem; border: 1px solid color-mix(in srgb, var(--gold) 55%, transparent); background: color-mix(in srgb, var(--wood) 55%, transparent); box-shadow: 0 25px 45px -30px rgb(0 0 0 / 0.8); }
  .findus__frame { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: #e9e1d2; }
  .findus__frame iframe {
    position: absolute; inset: 0; width: 100%; height: 100%; border: 0;
    /* tone the map toward the site's warm palette, full colour on hover/focus */
    filter: sepia(0.18) saturate(0.85) contrast(1.02);
    transition: filter var(--dur-2) var(--ease);
  }
  .findus__frame:hover iframe, .findus__frame:focus-within iframe { filter: none; }
  .findus__caption { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.7rem; font-family: var(--font-display); font-style: italic; font-size: var(--step-1); color: var(--gold-light); }
  .findus__pin { width: 0.8rem; height: 0.8rem; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 0 color-mix(in srgb, var(--gold) 60%, transparent); animation: pin-pulse 2.2s var(--ease) infinite; flex: none; }
  @keyframes pin-pulse { 0% { box-shadow: 0 0 0 0 rgb(176 141 87 / 0.6); } 100% { box-shadow: 0 0 0 12px rgb(176 141 87 / 0); } }
  .findus__steps { margin: 0 0 1.5rem; padding: 0; list-style: none; counter-reset: s; display: grid; gap: 0.9rem; }
  .findus__steps li { counter-increment: s; display: grid; grid-template-columns: 2.2rem 1fr; gap: 0.75rem; align-items: baseline; }
  .findus__steps li::before { content: counter(s); font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; color: var(--gold-light); border-bottom: 1px solid var(--gold); text-align: center; line-height: 1.1; }
  .findus__photo { position: relative; margin: 0 0 1.5rem; aspect-ratio: 4 / 3; border: 1px solid color-mix(in srgb, var(--gold) 50%, transparent); padding: 0.6rem; }
  .findus__photo img { width: 100%; height: 100%; object-fit: cover; }
  .findus__placeholder { height: 100%; display: grid; place-content: center; justify-items: center; gap: 0.6rem; color: var(--gold-light); font-style: italic; font-size: 0.9rem; text-align: center; background: color-mix(in srgb, var(--wood) 50%, transparent); }
  .findus__placeholder svg { width: 3rem; }
  .findus__btns { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  @media (min-width: 56rem) { .findus__grid { grid-template-columns: 1.5fr 1fr; } }
</style>
