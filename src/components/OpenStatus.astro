---
import info from '../data/info.json';
import { t, type Locale } from '../lib/i18n';
interface Props { locale: Locale; class?: string; tone?: 'light' | 'dark' }
const { locale, class: cls = '', tone = 'light' } = Astro.props;
const week = info.hours.week;
const strings = {
  open: t(locale, 'status.open'),
  closed: t(locale, 'status.closed'),
  closedTomorrow: t(locale, 'status.closedTomorrow'),
  closedDays: t(locale, 'status.closedDays'),
};
const first = (week['1'] ?? [])[0];
const fallback = first ? `${first[0]}–${first[1]}` : '';
---
<p
  class:list={['status', `status--${tone}`, cls]}
  data-open-status
  data-week={JSON.stringify(week)}
  data-strings={JSON.stringify(strings)}
>
  <span class="status__dot" aria-hidden="true"></span>
  <span class="status__text">{fallback}</span>
</p>

<script>
  import { getOpenStatus, type WeekHours } from '../lib/open-status';

  function render(el: HTMLElement) {
    const week = JSON.parse(el.dataset.week || '{}') as WeekHours;
    const s = JSON.parse(el.dataset.strings || '{}') as Record<string, string>;
    const st = getOpenStatus(week);
    let text: string;
    if (st.open) text = s.open.replace('{time}', st.closesAt ?? '');
    else if (st.opensAt && st.opensInDays === 0) text = s.closed.replace('{time}', st.opensAt);
    else if (st.opensAt && st.opensInDays === 1) text = s.closedTomorrow.replace('{time}', st.opensAt);
    else text = s.closedDays;
    el.dataset.state = st.open ? 'open' : 'closed';
    const t = el.querySelector('.status__text');
    if (t && t.textContent !== text) t.textContent = text;
  }
  const all = () => document.querySelectorAll<HTMLElement>('[data-open-status]').forEach(render);
  all();
  setInterval(all, 60_000);
  document.addEventListener('visibilitychange', () => { if (!document.hidden) all(); });
</script>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    margin: 0;
    padding: 0.32em 0.95em 0.32em 0.8em;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    line-height: 1.3;
    white-space: nowrap;
    color: var(--fg);
    background: color-mix(in srgb, var(--cream) 70%, transparent);
    backdrop-filter: blur(4px);
  }
  .status--dark {
    color: var(--cream);
    background: color-mix(in srgb, var(--wood) 55%, transparent);
    border-color: color-mix(in srgb, var(--gold) 50%, transparent);
  }
  .status__dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--taupe);
    flex: none;
  }
  [data-state='open'] .status__dot {
    background: #4f8a3e;
    box-shadow: 0 0 0 0 rgb(79 138 62 / 0.5);
    animation: status-pulse 2.8s var(--ease) infinite;
  }
  [data-state='closed'] .status__dot { background: var(--marble-red); }
  @keyframes status-pulse {
    0% { box-shadow: 0 0 0 0 rgb(79 138 62 / 0.45); }
    70% { box-shadow: 0 0 0 0.55em rgb(79 138 62 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(79 138 62 / 0); }
  }
</style>
