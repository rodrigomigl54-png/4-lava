---
/** Abstract origin seals — NOT real coats of arms. vienna: stylised double-headed bird in a roundel; istanbul: crescent and star tile. */
interface Props { kind: 'vienna' | 'istanbul'; class?: string; size?: string }
const { kind, class: cls = '', size = '3rem' } = Astro.props;
---
<svg class:list={['emblem', cls]} viewBox="0 0 48 48" style={`width:${size};height:${size}`} aria-hidden="true" focusable="false">
  <circle cx="24" cy="24" r="22" fill="none" stroke="currentColor" stroke-width="1.2" />
  <circle cx="24" cy="24" r="19" fill="none" stroke="currentColor" stroke-width=".6" stroke-dasharray="1.5 2" />
  {kind === 'vienna' ? (
    <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M24 16v18M24 34l-3 4M24 34l3 4" />
      <path d="M24 20c-3-4-8-5-12-3 2 4 6 6 10 6M24 20c3-4 8-5 12-3-2 4-6 6-10 6" />
      <path d="M20 13c-2-2-5-2-6 0 2 0 3 1 3 3M28 13c2-2 5-2 6 0-2 0-3 1-3 3" />
      <path d="M20 24c-3 2-6 6-6 9M28 24c3 2 6 6 6 9" />
      <path d="M21 11l3-3 3 3" />
    </g>
  ) : (
    <g fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round">
      <path d="M26 13a11 11 0 1 0 0 22 9 9 0 1 1 0-22Z" />
      <path d="M32 20l1.2 2.6 2.8.3-2.1 1.9.6 2.8-2.5-1.4-2.5 1.4.6-2.8-2.1-1.9 2.8-.3Z" />
    </g>
  )}
</svg>
<style>.emblem { color: var(--gold); flex: none; }</style>
